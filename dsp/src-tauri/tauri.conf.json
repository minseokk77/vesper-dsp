{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VesperDSP",
  "version": "0.0.22",
  "identifier": "com.vesper.dsp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:15173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vesper DSP",
        "width": 360,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* https://api.github.com https://raw.githubusercontent.com; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQjIwRUQ4MzI5QjY4RkQKUldUOWFKc3kyQTZ5dlJGQmFJYzdFTVo0MEhJSVhnZXVkUkVhL1JHeVF3VnlyT2VrZFpzRHhlL0UK",
      "windows": {
        "installMode": "quiet"
      },
      "endpoints": [
        "https://raw.githubusercontent.com/MINSEOKK77/vesper-dsp/master/updater.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "template": "../../installer-template.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
